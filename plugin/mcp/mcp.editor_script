-- defold-ai bridge editor script.
-- Registers HTTP routes /mcp/<tool> for the Python MCP server to call.
--
-- Reload: editor_reload_plugin invalidates the require-cache so handler edits
-- become live without restarting Defold. Restart is only needed when this
-- entry-point file itself is edited (routes table).

local M = {}

local util = require "mcp.lib.util"

-- ============ tool registry ============
-- Each entry: { module = "mcp.handlers.X", fn = "function_name" }.
-- We resolve module + function lazily on every request so editor_reload_plugin
-- (which clears package.loaded) actually picks up handler edits.
local TOOLS = {
  -- editor
  ping                       = { inline = function(_) return { ok = true, version = "0.8.0" } end },
  editor_state               = { module = "mcp.handlers.editor",        fn = "state" },
  editor_screenshot          = { module = "mcp.handlers.editor",        fn = "screenshot" },
  editor_manage              = { module = "mcp.handlers.editor",        fn = "manage" },
  editor_reload_plugin       = { module = "mcp.handlers.editor",        fn = "reload_plugin" },

  -- collection
  collection_manage          = { module = "mcp.handlers.collection",    fn = "manage" },
  collection_get_hierarchy   = { module = "mcp.handlers.collection",    fn = "get_hierarchy" },
  collection_open            = { module = "mcp.handlers.collection",    fn = "open" },
  collection_save            = { module = "mcp.handlers.collection",    fn = "save" },

  -- gameobject
  gameobject_create          = { module = "mcp.handlers.gameobject",    fn = "create" },
  gameobject_set_property    = { module = "mcp.handlers.gameobject",    fn = "set_property" },
  gameobject_get_properties  = { module = "mcp.handlers.gameobject",    fn = "get_properties" },
  gameobject_find            = { module = "mcp.handlers.gameobject",    fn = "find" },
  gameobject_manage          = { module = "mcp.handlers.gameobject",    fn = "manage" },

  -- component
  component_add              = { module = "mcp.handlers.component",     fn = "add" },
  component_remove           = { module = "mcp.handlers.component",     fn = "remove" },

  -- script
  script_create              = { module = "mcp.handlers.script",        fn = "create" },
  script_attach              = { module = "mcp.handlers.script",        fn = "attach" },
  script_patch               = { module = "mcp.handlers.script",        fn = "patch" },
  script_manage              = { module = "mcp.handlers.script",        fn = "manage" },

  -- resource
  resource_manage            = { module = "mcp.handlers.resource",      fn = "manage" },
  material_manage            = { module = "mcp.handlers.resource",      fn = "material_manage" },
  particlefx_manage          = { module = "mcp.handlers.resource",      fn = "particlefx_manage" },
  atlas_manage               = { module = "mcp.handlers.resource",      fn = "atlas_manage" },
  tilesource_manage          = { module = "mcp.handlers.resource",      fn = "tilesource_manage" },
  tilemap_manage             = { module = "mcp.handlers.resource",      fn = "tilemap_manage" },
  render_manage              = { module = "mcp.handlers.render",        fn = "manage" },
  camera_manage              = { module = "mcp.handlers.camera",        fn = "manage" },

  -- filesystem
  filesystem_manage          = { module = "mcp.handlers.filesystem",    fn = "manage" },

  -- input
  input_binding_manage       = { module = "mcp.handlers.input_binding", fn = "manage" },

  -- project
  project_run                = { module = "mcp.handlers.project",       fn = "run" },
  project_manage             = { module = "mcp.handlers.project",       fn = "manage" },
  logs_read                  = { module = "mcp.handlers.project",       fn = "logs_read" },
  batch_execute              = { module = "mcp.handlers.project",       fn = "batch_execute" },
}

-- Resolve a registered tool to its current callable. Returns nil if unknown.
local function resolve(tool_name)
  local entry = TOOLS[tool_name]
  if not entry then return nil end
  if entry.inline then return entry.inline end
  local mod = require(entry.module)
  return mod[entry.fn]
end

-- batch_execute needs a flat name→callable map; build one lazily.
local function tools_callable_map()
  local out = {}
  for name, _ in pairs(TOOLS) do
    out[name] = resolve(name)
  end
  return out
end

-- ============ HTTP route handler ============
local function dispatch(tool_name)
  return function(request)
    local body = request.body or {}
    local handler = resolve(tool_name)
    if handler == nil then
      return http.server.json_response({
        ok = false,
        error = "UNKNOWN_TOOL",
        message = "No handler for tool: " .. tool_name,
      }, 404)
    end
    -- For batch_execute, refresh the registry reference each call.
    if tool_name == "batch_execute" then
      local proj = require("mcp.handlers.project")
      if proj._set_tools_registry then proj._set_tools_registry(tools_callable_map()) end
    end
    local ok, result_or_err = pcall(handler, body)
    if not ok then
      print("[defold-ai] handler error in " .. tool_name .. ": " .. tostring(result_or_err))
      return http.server.json_response({
        ok = false,
        error = "HANDLER_ERROR",
        message = tostring(result_or_err),
        tool = tool_name,
      }, 500)
    end
    if type(result_or_err) ~= "table" then
      result_or_err = { value = result_or_err }
    end
    if result_or_err.ok == nil then
      result_or_err.ok = true
    end
    return http.server.json_response(result_or_err)
  end
end

-- ============ Route registration ============
function M.get_http_server_routes()
  local routes = {}
  for tool_name, _ in pairs(TOOLS) do
    table.insert(routes, http.server.route("/mcp/" .. tool_name, "POST", "json", dispatch(tool_name)))
  end
  table.insert(routes, http.server.route("/mcp/ping", "GET", function(_)
    return http.server.json_response({ ok = true, version = "0.8.0" })
  end))
  return routes
end

-- ============ Optional commands menu ============
function M.get_commands()
  return {
    {
      label = "defold-ai: Print HTTP URL",
      locations = { "Edit" },
      run = function()
        print("[defold-ai] HTTP URL: " .. http.server.url)
        print("[defold-ai] Set DEFOLD_AI_URL=" .. http.server.url .. " for the MCP server")
      end,
    },
    {
      label = "defold-ai: Refresh ~/.defold_ai_url",
      locations = { "Edit" },
      run = function()
        util.write_url_file(http.server.url)
        print("[defold-ai] Wrote " .. http.server.url .. " to ~/.defold_ai_url")
      end,
    },
  }
end

-- ============ Boot announce ============
print("[defold-ai] editor script loaded — " .. util.count_tools(TOOLS) .. " tools registered (v0.8.0)")
print("[defold-ai] HTTP server at " .. http.server.url)
local ok, err = pcall(util.write_url_file, http.server.url)
if not ok then
  print("[defold-ai] could not write ~/.defold_ai_url: " .. tostring(err))
end

return M
